<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Polispolis.View.StartExercisePage"
             Title="StartExercisePage">
    <Grid Padding="25">
        <Border BackgroundColor="{StaticResource DarkGray}"
                Padding="25"
                StrokeThickness="0"
                Shadow="10,10,20,Black">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout>
                    <Picker Title="Select Category"
                            ItemsSource="{Binding AllCategoriesCollection}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"></Picker>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
   
</ContentPage>