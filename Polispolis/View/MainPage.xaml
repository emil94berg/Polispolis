<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Polispolis.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="homepage_icon.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="HomePageIcon" />
            <Label
                Text="Welcome"
                Style="{StaticResource Headline}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    Text="Log in"
                    x:Name="LogInButton"
                    SemanticProperties.Hint="Log_In"
                    Clicked="LogInButton_Clicked"/>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    Text="Add Exercise"
                    x:Name="AddExerciseButton"
                    SemanticProperties.Hint="Add_Exercise"
                    Clicked="AddExerciseButton_Clicked"/>
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10"
                    Text="Add Category"
                    x:Name="AddCaregoryButton"
                    SemanticProperties.Hint="Add_Exercise"
                    Clicked="AddCategory_Clicked"/>


            </Grid>
        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>
